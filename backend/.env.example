# Copy this file to .env and fill in your values.
# The .env file is NOT committed to version control.

# ── Database (admin connection, used by schema reader and benchmark runner) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=northwind
DB_USER=postgres
DB_PASSWORD=postgres

# ── Read-only connection (used by query executor) ──
DB_READONLY_USER=askdata_reader
DB_READONLY_PASSWORD=askdata_readonly_pw

# ── LLM provider ──
# Set LLM_PROVIDER to "openai" | "google" | "anthropic" | "groq"
# Then set the matching API key below and pick the right model.
LLM_PROVIDER=google
LLM_MODEL=gemini-3.8-flash    # google option
# LLM_MODEL=gpt-4o-mini       # openai option
# LLM_MODEL=claude-3-haiku-20240307  # anthropic option
# LLM_MODEL=qwen/qwen3.8-27b          # Groq option (recommended fast SQL generation)
# LLM_MODEL=openai/gpt-oss-20b        # Groq option
# LLM_MODEL=openai/gpt-oss-120b       # Groq option

# OpenAI
OPENAI_API_KEY=sk-...

# Google (if using Gemini)
# GOOGLE_API_KEY=...

# Anthropic (if using Claude)
# ANTHROPIC_API_KEY=...

# Groq
# GROQ_API_KEY=...

# ── Safety limits ──
QUERY_TIMEOUT_SECONDS=10
QUERY_ROW_LIMIT=1000
